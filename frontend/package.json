{
  "name": "sar-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x", "npm": "11.x" },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
